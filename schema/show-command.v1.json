{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DAYSRA show-command v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool", "argv"],
  "properties": {
    "schema_version": {"const": "1"},
    "tool": {"enum": ["subfinder", "httpx", "nuclei"]},
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    }
  }
}
